<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Default local endpoint: http://127.0.0.1:8768; the installer renders the port. -->
<dict>
  <key>Label</key>
  <string>com.ya-fundmind.web</string>
  <key>ProgramArguments</key>
  <array>
    <string>${PYTHON_BIN}</string>
    <string>-m</string>
    <string>fund_agent.cli</string>
    <string>product-web</string>
    <string>--output-dir</string>
    <string>${OUTPUT_ROOT}</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>${PORT}</string>
  </array>
  <key>WorkingDirectory</key>
  <string>${YA_FUNDMIND_PROJECT_DIR}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>${OUTPUT_ROOT}/logs/product-web.out.log</string>
  <key>StandardErrorPath</key>
  <string>${OUTPUT_ROOT}/logs/product-web.err.log</string>
</dict>
</plist>
