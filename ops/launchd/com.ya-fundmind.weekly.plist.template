<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ya-fundmind.weekly</string>
  <key>WorkingDirectory</key>
  <string>${YA_FUNDMIND_PROJECT_DIR}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>${YA_FUNDMIND_PROJECT_DIR}/scripts/run_weekly_ops.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>YA_FUNDMIND_PROJECT_DIR</key>
    <string>${YA_FUNDMIND_PROJECT_DIR}</string>
    <key>PYTHON_BIN</key>
    <string>${PYTHON_BIN}</string>
    <key>OUTPUT_DIR</key>
    <string>outputs</string>
    <key>PROVIDER</key>
    <string>fixture</string>
    <key>FUND_AGENT_SKIP_TIANTIAN_SMOKE</key>
    <string>true</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>6</integer>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>${YA_FUNDMIND_PROJECT_DIR}/outputs/logs/launchd-weekly.out.log</string>
  <key>StandardErrorPath</key>
  <string>${YA_FUNDMIND_PROJECT_DIR}/outputs/logs/launchd-weekly.err.log</string>
</dict>
</plist>
